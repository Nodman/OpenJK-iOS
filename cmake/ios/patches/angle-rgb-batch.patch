+class RGBTextureUploadTest : public Texture2DTest
+{
+  protected:
+    void testSetUp() override
+    {
+        Texture2DTest::testSetUp();
+        setUpProgram();
+        glBindTexture(GL_TEXTURE_2D, mTexture2D);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+    }
+
+    GLColor colorAt(int x, int y, int seed)
+    {
+        return GLColor((17 * x + 31 * y + 43 * seed) % 256, (59 * x + 7 * y + 73 * seed) % 256,
+                       (11 * x + 47 * y + 23 * seed) % 256, 255);
+    }
+
+    std::vector<GLubyte> makeRGBData(int width,
+                                     int height,
+                                     int alignment,
+                                     int seed,
+                                     int skipPixels = 0,
+                                     int skipRows   = 0,
+                                     int rowLength  = 0)
+    {
+        const int inputWidth = rowLength ? rowLength : width;
+        const int rowPitch   = ((inputWidth * 3 + alignment - 1) / alignment) * alignment;
+        std::vector<GLubyte> data(rowPitch * (height + skipRows), 0xA5);
+        for (int y = 0; y < height; ++y)
+        {
+            for (int x = 0; x < width; ++x)
+            {
+                const GLColor color = colorAt(x, y, seed);
+                const int offset    = (y + skipRows) * rowPitch + (x + skipPixels) * 3;
+                data[offset]        = color.R;
+                data[offset + 1]    = color.G;
+                data[offset + 2]    = color.B;
+            }
+        }
+        return data;
+    }
+
+    void expectSampledImage(int width, int height, const std::vector<GLColor> &expected)
+    {
+        glBindTexture(GL_TEXTURE_2D, mFramebufferColorTexture);
+        glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA, width, height, 0, GL_RGBA, GL_UNSIGNED_BYTE,
+                     nullptr);
+        glBindTexture(GL_TEXTURE_2D, mTexture2D);
+        glViewport(0, 0, width, height);
+        ASSERT_GL_FRAMEBUFFER_COMPLETE(GL_FRAMEBUFFER);
+        drawQuad(mProgram, "position", 0.0f);
+        std::vector<GLColor> actual(width * height);
+        glReadPixels(0, 0, width, height, GL_RGBA, GL_UNSIGNED_BYTE, actual.data());
+        ASSERT_GL_NO_ERROR();
+        for (int y = 0; y < height; ++y)
+        {
+            for (int x = 0; x < width; ++x)
+            {
+                ASSERT_EQ(expected[y * width + x], actual[y * width + x])
+                    << "at (" << x << ", " << y << ")";
+            }
+        }
+    }
+
+    void testRegion(int width, int height, int alignment, bool unpackSkips = false)
+    {
+        SCOPED_TRACE(::testing::Message() << width << "x" << height << " alignment " << alignment);
+        glPixelStorei(GL_UNPACK_ALIGNMENT, alignment);
+        std::vector<GLubyte> full = makeRGBData(width, height, alignment, 1);
+        glTexImage2D(GL_TEXTURE_2D, 0, GL_RGB, width, height, 0, GL_RGB, GL_UNSIGNED_BYTE,
+                     full.data());
+        std::vector<GLColor> expected(width * height);
+        for (int y = 0; y < height; ++y)
+        {
+            for (int x = 0; x < width; ++x)
+            {
+                expected[y * width + x] = colorAt(x, y, 1);
+            }
+        }
+        ASSERT_GL_NO_ERROR();
+        expectSampledImage(width, height, expected);
+
+        const int textureWidth          = width + 4;
+        const int textureHeight         = height + 4;
+        std::vector<GLubyte> background = makeRGBData(textureWidth, textureHeight, alignment, 0);
+        glTexImage2D(GL_TEXTURE_2D, 0, GL_RGB, textureWidth, textureHeight, 0, GL_RGB,
+                     GL_UNSIGNED_BYTE, background.data());
+        expected.resize(textureWidth * textureHeight);
+        for (int y = 0; y < textureHeight; ++y)
+        {
+            for (int x = 0; x < textureWidth; ++x)
+            {
+                expected[y * textureWidth + x] = colorAt(x, y, 0);
+            }
+        }
+        expectSampledImage(textureWidth, textureHeight, expected);
+
+        for (int seed : {2, 3})
+        {
+            const int rowLength  = unpackSkips ? width + 3 : 0;
+            const int skipRows   = unpackSkips ? 2 : 0;
+            const int skipPixels = unpackSkips ? 1 : 0;
+            if (unpackSkips)
+            {
+                glPixelStorei(GL_UNPACK_ROW_LENGTH_EXT, rowLength);
+                glPixelStorei(GL_UNPACK_SKIP_ROWS_EXT, skipRows);
+                glPixelStorei(GL_UNPACK_SKIP_PIXELS_EXT, skipPixels);
+            }
+            std::vector<GLubyte> update =
+                makeRGBData(width, height, alignment, seed, skipPixels, skipRows, rowLength);
+            glTexSubImage2D(GL_TEXTURE_2D, 0, 2, 2, width, height, GL_RGB, GL_UNSIGNED_BYTE,
+                            update.data());
+            if (unpackSkips)
+            {
+                glPixelStorei(GL_UNPACK_ROW_LENGTH_EXT, 0);
+                glPixelStorei(GL_UNPACK_SKIP_ROWS_EXT, 0);
+                glPixelStorei(GL_UNPACK_SKIP_PIXELS_EXT, 0);
+            }
+            ASSERT_GL_NO_ERROR();
+            for (int y = 0; y < height; ++y)
+            {
+                for (int x = 0; x < width; ++x)
+                {
+                    expected[(y + 2) * textureWidth + x + 2] = colorAt(x, y, seed);
+                }
+            }
+            expectSampledImage(textureWidth, textureHeight, expected);
+        }
+
+        GLubyte unused[] = {255, 0, 255};
+        glTexSubImage2D(GL_TEXTURE_2D, 0, 2, 2, 0, height, GL_RGB, GL_UNSIGNED_BYTE, unused);
+        glTexSubImage2D(GL_TEXTURE_2D, 0, 2, 2, width, 0, GL_RGB, GL_UNSIGNED_BYTE, unused);
+        ASSERT_GL_NO_ERROR();
+        expectSampledImage(textureWidth, textureHeight, expected);
+        glPixelStorei(GL_UNPACK_ALIGNMENT, 4);
+    }
+};
+
+TEST_P(RGBTextureUploadTest, FullAndOffsetSubImages)
+{
+    for (int alignment : {1, 4, 8})
+    {
+        testRegion(5, 7, alignment);
+    }
+}
+
+TEST_P(RGBTextureUploadTest, SingleRowAndColumn)
+{
+    for (int alignment : {1, 4, 8})
+    {
+        testRegion(7, 1, alignment);
+        testRegion(1, 7, alignment);
+    }
+}
+
+TEST_P(RGBTextureUploadTest, UnpackSkips)
+{
+    ANGLE_SKIP_TEST_IF(!EnsureGLExtensionEnabled("GL_EXT_unpack_subimage"));
+    for (int alignment : {1, 4, 8})
+    {
+        testRegion(5, 7, alignment, true);
+    }
+}
+
+TEST_P(RGBTextureUploadTest, ConversionSizeBoundary)
+{
+    // RGBA conversion bytes fall below, at, and above the 1 MiB batching ceiling.
+    for (int width : {511, 512, 513})
+    {
+        testRegion(width, 512, 4);
+    }
+}
